    <script type="text/javascript" src="js/service-worker-register.js"></script>
    <script src="js/framework/framework7-bundle.min.js"></script>
    <script src="js/theradiofm.config.js"></script>
    <script src="js/plugins/theradiofm.core.min.js"></script>
    <script>
    theradiofmCorePlugin.appLoaded();

    // Track the active iframe ID
    let activeIframeId = null;

    // Function to load loading.html and then the target page after a 0.5-second delay
    function loadWithDelay(event, iframeId, loadingSrc, targetSrc) {
        const iframe = document.getElementById(iframeId);
        if (iframe.src.includes(loadingSrc)) {
            iframe.src = loadingSrc;
            setTimeout(() => {
                iframe.src = targetSrc;  // Load the actual content after 0.5 seconds
            }, 500); 
            activeIframeId = iframeId; // Set the active iframe ID
        } else if (lastClickedTab === event.currentTarget) {
            iframe.src = iframe.src,  // Load the actual content after 0.5 seconds
            activeIframeId = iframeId; // Set the active iframe ID
        }
        lastClickedTab = event.currentTarget;
    }

    window.addEventListener('popstate', function(event) {
        event.preventDefault(); // Cancel the default browser action for popstate

        // Check if there's an active iframe and ensure it's not reloading
        if (activeIframeId) {
            const iframe = document.getElementById(activeIframeId);
            if (iframe && !iframe.src.includes('loading.html')) {
                // Prevent reloading the iframe by not resetting the src attribute
                // You may include any other logic if necessary
                return;
            }
        }
    });

    let lastClickedTab = null;
let clickCount = 0;

function handleTabClick(event, iframeId, loadingSrc, triggerSrc) {
    const iframe = document.getElementById(iframeId);

    if (lastClickedTab === event.currentTarget) {
        clickCount++;  // Increment the click count if the same tab is clicked again
    } else {
        clickCount = 1;  // Reset the count if a different tab is clicked
    }

    if (clickCount === 2) {
        // Reload the iframe only on the second consecutive click
        iframe.src = loadingSrc;  // Load the loading.html first
        setTimeout(() => {
            iframe.src = triggerSrc;  // Load the actual content after 0.5 seconds
        }, 1);  // 500ms delay
        clickCount = 0;  // Reset the click count after the reload
    }

    // Update the last clicked tab
    lastClickedTab = event.currentTarget;
}




    const tabLinks = [
                //{ id: 'o-1012', iframeId: 'iframe-1040', loadingSrc: 'pages/loading.html', triggerSrc: 'pages/cover/index.html' },
                { id: 'o-1012', iframeId: 'iframe-1041', loadingSrc: 'pages/loading.html', triggerSrc: 'pages/radios.html' },
                { id: 'o-1017', iframeId: 'iframe-1042', loadingSrc: 'pages/loading.html', triggerSrc: 'pages/yt.html' },
                { id: 'o-1022', iframeId: 'iframe-1043', loadingSrc: 'pages/loading.html', triggerSrc: 'pages/fluid.html' },
                { id: 'o-1027', iframeId: 'iframe-1044', loadingSrc: 'pages/loading.html', triggerSrc: 'pages/gamesnacks.html' },
                { id: 'o-1032', iframeId: 'iframe-1045', loadingSrc: 'pages/loading.html', triggerSrc: 'pages/gamesnacks.html' },
                { id: 'o-1037', iframeId: 'iframe-1046', loadingSrc: 'pages/loading.html', triggerSrc: 'pages/gamesnacks.html' },
    ];

    tabLinks.forEach(tab => {
        document.getElementById(tab.id).addEventListener('click', event => {
            loadWithDelay(event, tab.iframeId, tab.loadingSrc, tab.triggerSrc);
        });
    });

    document.querySelectorAll('.hidden-focus-element').forEach(element => {
        element.setAttribute('tabindex', '-1');
    });

    document.querySelectorAll('.tab-link').forEach(element => {
        element.setAttribute('tabindex', '0');
    });
       
    </script>
