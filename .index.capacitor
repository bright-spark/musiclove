    <script type="text/javascript" src="js/service-worker-register.js"></script>
    <script type="text/javascript" src="js/framework/framework7-bundle.min.js"></script>
    <script type="text/javascript" src="js/thorium.config.js"></script>
    <script type="text/javascript" src="js/plugins/thorium.core.min.js"></script>
    <script type="text/javascript" src="js/custom.js" ></script>
    
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            if (typeof thoriumCorePlugin !== 'undefined') {
                thoriumCorePlugin.appLoaded();
            }
        });
    </script>

    <script>
        // JavaScript to reload tabs on every second consecutive click
        const tabs = document.querySelectorAll('.tab-link');
        const clickCounts = {};
        let lastTab = "";  // Declare lastTab globally to track between clicks
    
        tabs.forEach(tab => {
            const tabId = tab.getAttribute('href');
            clickCounts[tabId] = 0; // Initialize click count for each tab
    
            tab.addEventListener('click', function (e) {
                e.preventDefault();  // Prevent default link behavior if necessary
    
                // Check if the current tab was the last clicked tab
                if (lastTab === tabId) {
                    clickCounts[tabId]++;
                } else {
                    clickCounts[tabId] = 1; // Reset count if a different tab is clicked
                }
    
                // Set lastTab to the current tab
                lastTab = tabId;
    
                // Reload the tab's iframe on every second click
                if (clickCounts[tabId] % 2 === 0) {
                    // Find the iframe inside the tab and reload its src
                    const iframe = document.querySelector(`${tabId} iframe`);
                    if (iframe) {
                        const src = iframe.getAttribute('src');
                        iframe.setAttribute('src', src); // Reload iframe
                    }
                }
            });
        });
    </script>


