Options -Indexes
<Files ~ "\.db$">
    Order allow,deny
    Deny from all
</Files>

# Cookie-friendly defaults: avoid COEP/COOP (they break many cross-origin embeds and storage flows).
# Send sensible hygiene headers only.
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff" 
</IfModule>