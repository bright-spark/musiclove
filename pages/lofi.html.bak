<!DOCTYPE html>
<html lang="en">

<head>



    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-title" content="theradio.fm">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="mobile-web-app-capable" content="yes">

    <meta name="HandheldFriendly" content="true">
    <meta name="MobileOptimized" content="400">

    <title>Lofi Music</title>
    <meta charset="utf-8">

    <!--display:block;  overflow:hidden; top:0; left:0; bottom:0; right:0; width:100%; height:100%; border:none; margin:0; padding:0; z-index:999999;-->

    <style>
        html,
        body,
        iframe {
            margin: 0;
            padding: 0;
            top: 0;
            left: 0;
            bottom: 0;
            right: 0;
            height: 100vh;
            z-index: 999999;
        }

        iframe {
            overflow: hidden;
            display: block;
            width: 100%;
            border: none;
        }
    </style>


    <meta name="viewport" content="width=device-width, viewport-fit=cover, initial-scale=1.0">





</head>

<body>
    <iframe title="flexi-flux" src="https://chainflare.site/embed?url=https://lofimusic.app/?ref=theradiofm"
        allow="autoplay; encrypted-media; web-share" type="text/html" allowfullscreen></iframe>
</body>

</html>