<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Suppress Cookie Banners</title>
  <style>
    body, html {
      margin: 0;
      padding: 0;
      width: 100%;
      height: 100%;
      overflow: hidden; /* Prevents scrolling */
    }
    iframe {
      border: none;
      width: 100%;
      height: 100%;
    }
  </style>
</head>
<body>
  <iframe id="iframeID" src="https://wimpy.co.za"></iframe>
  <script>
    document.getElementById('iframeID').onload = function() {
      let iframe = document.getElementById('iframeID');
      let iframeWindow = iframe.contentWindow;
      let iframeDoc = iframeWindow.document;

      // Common selectors for cookie banners
      let selectors = ['.cookie-banner', '#cookie_bar', '#cookie-consent', '.cookie-consent'];

      // Function to hide elements
      function hideCookieBanners() {
        selectors.forEach(selector => {
          let elements = iframeDoc.querySelectorAll(selector);
          elements.forEach(el => el.style.display = 'none');
        });
      }

      // Initial suppression
      hideCookieBanners();

      // Observer for dynamic content
      let observer = new MutationObserver(() => {
        hideCookieBanners();
      });
      observer.observe(iframeDoc.body, { childList: true, subtree: true });
    };
  </script>
</body>
</html>
