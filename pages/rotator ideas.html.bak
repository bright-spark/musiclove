<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dynamic URL Loader</title>
    <style>
        body, html {
            margin: 0;
            padding: 0;
            height: 100%;
            overflow: hidden;
        }
        iframe {
            width: 100%;
            height: 100%;
            border: none;
        }
    </style>
</head>
<body>
    <iframe id="content-frame"></iframe>
    <script>
        // X-Frame-Bypass URL
        const xframe = "https://x.xxlxx.co/?url="
        // Array of URLs
        const urls = [

            "https://4582b871325a4ed795541535d9f6eb7c.elf.site",

            "https://wimpy.co.za/?ref=theradio.fm",
            //"https://www.theradio.fm/?ref=wimpy.co.za",
            //"https://www.theradio.fm/?ref=playbet.net",
            //"https://www.theradio.fm/?ref=hollywoodbets.net",
            
            
            "https://playbet.net/page/home/?ref=theradio.fm",

            //"https://www.hollywoodbets.net/?ref=theradio.fm",
            //"https://www.bet.co.za/?ref=theradio.fm",
            //"https://www.betway.co.za/?ref=theradio.fm",

            //"https://www.montecasino.co.za/?ref=theradio.fm",
            //"https://www.tsogosun.com/?ref=theradio.fm",

            "https://www.suninternational.com/?ref=theradio.fm",
            "https://www.tsogosun.com/?ref=theradio.fm",
            "https://www.southafrica.net/?ref=theradio.fm",
            "https://www.southafrica.net/za/en/?ref=theradio.fm",
            "https://www.southafrica.net/za/en/travel/category/places-to-go/?ref=theradio.fm",
            "https://www.southafrica.net/za/en/travel/category/things-to-do/?ref=theradio.fm",

        ];

        // Retrieve current index from localStorage
        let currentIndex = parseInt(localStorage.getItem('currentIndex')) || 0;

        // Increment index
        currentIndex = (currentIndex + 1) % urls.length;

        // Save new index to localStorage
        localStorage.setItem('currentIndex', currentIndex);

        // Set iframe src to the current URL
        document.getElementById('content-frame').src = urls[currentIndex];
    </script>
</body>
</html>
