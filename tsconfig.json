{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "lib": ["ES2020", "DOM"],
    "outDir": "./js",
    "rootDir": "./src",
    "strict": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "noEmitOnError": true
  },
  "include": ["src/site/**/*.ts", "src/globals.d.ts"]
}
